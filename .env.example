JWT_SECRET=secret

# Configuração do banco de dados
DATABASE_NAME=echoes
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=echoes
DATABASE_USER_PASSWORD=admin
DATABASE_ROOT_PASSWORD=echoes-root

# URL
DATABASE_URL=jdbc:mysql://${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# Configuração do email
EMAIL_HOST=host
EMAIL_PORT=587
EMAIL_USERNAME=user@email.com
EMAIL_PASSWORD=senha

# Configuração do redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=echoes-redis
#
# Configuração do MQTT (autocadastro de dispositivos)
MQTT_ENABLED=true
# Dentro do docker-compose o app usa o Mosquitto do stack automaticamente (ver docker-compose.yml).
# Ao rodar fora do Docker contra o Mosquitto local, use: MQTT_BROKER_URL=tcp://localhost:1883
MQTT_BROKER_URL=ssl://host
MQTT_CLIENT_ID=echoes-server
MQTT_USERNAME=user
MQTT_PASSWORD=password
MQTT_REGISTRATION_TOPIC=register
MQTT_ACK_TOPIC=register/ack/{hardware_id}
MQTT_QOS=1
# Porta do Mosquitto exposta no host (docker-compose)
MQTT_PORT=1883

# Chave SSL para HTTPS/TLS
USE_SSL=false
SSL_KEYSTORE_PATH=/app/keystore.p12
SSL_KEYSTORE_PASSWORD=123456
SSL_KEYSTORE_TYPE=PKCS12
SSL_ALIAS=meu-cert
# Utilize esse para emails (descomente)
# TWO_FACTOR_PROVIDER=email
# Utilize esse para logs
TWO_FACTOR_PROVIDER=logger

UPLOAD_DIR=uploads

# Apenas o nome das extensões, sem pontos ou espaços, separadas por vírgula
EXTENSIONS_ALLOWED=pdf,doc,docx,ppt,pptx,xls,xlsx,jpg,jpeg,png,gif

# Credenciais do usuário seed (SuperUserInitializer)
# ATENÇÃO: troque a senha antes de usar em qualquer ambiente compartilhado.
# O superusuário só é criado se ainda não existir um usuário com este e-mail.
ADMIN_EMAIL=admin@echoes.local
ADMIN_NAME=Administrador
ADMIN_PASSWORD=senha
