# Assina os JWT de sessão. Obrigatório, no mínimo 32 bytes aleatórios (ex.: openssl rand -base64 48).
# Use um valor DIFERENTE de AUDIT_HMAC_KEY.
JWT_SECRET=troque-por-um-segredo-aleatorio-com-32-bytes-ou-mais

# Configuração do banco de dados
DATABASE_NAME=echoes
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=echoes
DATABASE_USER_PASSWORD=troque-esta-senha
DATABASE_ROOT_PASSWORD=echoes-root

# URL
DATABASE_URL=jdbc:mysql://${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# Configuração do email
EMAIL_HOST=host
EMAIL_PORT=587
EMAIL_USERNAME=user@email.com
EMAIL_PASSWORD=

# Configuração do redis
# REDIS_PASSWORD é obrigatória e não pode ficar vazia: o compose sobe o Redis com --requirepass.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=troque-esta-senha-do-redis
#
# Configuração do MQTT (autocadastro de dispositivos)
MQTT_ENABLED=true
# Broker: HiveMQ Cloud (TLS, porta 8883). Deve ser o MESMO broker usado pelo firmware (Echoes-Embedded).
MQTT_BROKER_URL=ssl://<seu-cluster>.s1.eu.hivemq.cloud:8883
MQTT_CLIENT_ID=echoes-server
MQTT_USERNAME=troque-o-usuario-do-hivemq
MQTT_PASSWORD=troque-a-senha-do-hivemq
MQTT_REGISTRATION_TOPIC=register
MQTT_ACK_TOPIC=register/ack/{hardware_id}
MQTT_QOS=1

# Chave SSL para HTTPS/TLS
USE_SSL=false
SSL_KEYSTORE_PATH=/app/certs/keystore.p12
SSL_KEYSTORE_PASSWORD=
SSL_KEYSTORE_TYPE=PKCS12
SSL_ALIAS=meu-cert
# Utilize esse para emails (descomente)
# TWO_FACTOR_PROVIDER=email
# Utilize esse para logs
TWO_FACTOR_PROVIDER=logger

UPLOAD_DIR=uploads

# Apenas o nome das extensões, sem pontos ou espaços, separadas por vírgula
# Validador genérico de arquivos (propriedade obrigatória). Não é usado no upload de
# materiais nem de áudios de cenário: cada um tem a sua variável abaixo.
EXTENSIONS_ALLOWED=pdf,docx,jpg,jpeg,png

# Áudios de cenário aceitos em upload; o formato é checado pelo conteúdo.
# Atenção: o firmware atual só toca MP3 (ver registro de riscos).
SCENARIO_AUDIO_EXTENSIONS=mp3,wav,ogg,m4a

# Materiais de aula aceitos em upload (tipos reconhecidos: pdf, docx, pptx, xlsx,
# jpg, jpeg, png, gif, webp, txt, csv, md)
MATERIAL_EXTENSIONS_ALLOWED=pdf,docx,jpg,jpeg,png

# Credenciais do usuário seed (SuperUserInitializer)
# ATENÇÃO: troque a senha antes de usar em qualquer ambiente compartilhado.
# O superusuário só é criado se ainda não existir um usuário com este e-mail.
ADMIN_EMAIL=admin@echoes.local
ADMIN_NAME=Administrador
# Obrigatória. Precisa passar na PasswordPolicy: 8+ caracteres com maiúscula, minúscula,
# número e um símbolo entre @#$%^&+=! . Sem isso a aplicação não sobe ao criar o primeiro admin.
ADMIN_PASSWORD=


# Documentação Swagger/OpenAPI: deixe false em produção (S7)
SWAGGER_ENABLED=false

# Chave HMAC que assina os registros de auditoria (S15). Obrigatória, no mínimo 32 bytes
# aleatórios (ex.: openssl rand -base64 48) e DIFERENTE de JWT_SECRET.
# Trocar a chave invalida a verificação dos registros já assinados: arquive-os antes.
AUDIT_HMAC_KEY=troque-por-32-bytes-aleatorios-ou-mais-aqui

# Cookie da sessão (S10). Em desenvolvimento via http://localhost pode usar false
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Strict

# Limitação de taxa por IP em login/MFA/recuperação/entrada em turma (S9)
RATE_LIMIT_ENABLED=true

# Confie em X-Forwarded-For só atrás de um proxy que você controla (S13)
TRUST_FORWARDED_FOR=false

# Origens do front liberadas por CORS, separadas por vírgula (S22)
CORS_ALLOWED_ORIGINS=http://localhost:*

# URL pública do front, usada nos links de convite por e-mail (B9)
FRONTEND_URL=http://localhost:5173

# Atrás de proxy TLS: none (padrão), framework ou native (S3)
FORWARD_HEADERS_STRATEGY=none

# Exige a claim jti no token do dispositivo (S12). Use false só enquanto houver firmware antigo
DEVICE_JWT_REQUIRE_JTI=true

# Ajustes opcionais do histórico (Javers). Não são segredos; os padrões já servem para produção.
# Limpar mais alunos que isto de uma vez cria antes um checkpoint de restauração
# JAVERS_CHECKPOINT_THRESHOLD=10
# Poda do histórico: liga/desliga e horário (cron do Spring)
# JAVERS_RETENTION_ENABLED=true
# JAVERS_RETENTION_CRON=0 0 3 * * *
# Alerta por e-mail ao administrador quando a tabela jv_snapshot passa deste tamanho (MB)
# JAVERS_MONITOR_SNAPSHOT_BYTES_THRESHOLD_MB=8192

