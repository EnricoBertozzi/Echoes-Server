JWT_SECRET=troque-por-um-segredo-aleatorio-com-32-bytes-ou-mais

# Configuração do banco de dados
DATABASE_NAME=name
DATABASE_HOST=host
DATABASE_PORT=port
DATABASE_USER=user
DATABASE_USER_PASSWORD=password
DATABASE_ROOT_PASSWORD=password

# URL
DATABASE_URL=jdbc:mysql://${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# Configuração do email
EMAIL_HOST=smtp
EMAIL_PORT=port
EMAIL_USERNAME=email
EMAIL_PASSWORD=senha

# Configuração do redis
REDIS_HOST=host
REDIS_PORT=port
REDIS_PASSWORD=password

# Configuração do MQTT (autocadastro de dispositivos)
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=echoes-server-registration
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_REGISTRATION_TOPIC=register
MQTT_ACK_TOPIC=register/ack/{hardware_id}
MQTT_QOS=1

# Chave SSL para HTTPS/TLS
USE_SSL=false | true
SSL_KEYSTORE_PATH=path
SSL_KEYSTORE_PASSWORD=password
SSL_ALIAS=alias
SSL_KEYSTORE_TYPE=type

TWO_FACTOR_PROVIDER=email | logger

UPLOAD_DIR=path
# Use apenas o nome da extensão, sem pontos ou espaços
EXTENSIONS_ALLOWED=ext1,ext2,ext3

# Credencias do usuário seed
ADMIN_EMAIL=email
ADMIN_NAME=name
# obrigatória e forte: 8+ caracteres, maiúscula, minúscula, número e símbolo
ADMIN_PASSWORD=

# Documentação Swagger/OpenAPI: false em produção (S7)
SWAGGER_ENABLED=false

# Chave da assinatura de auditoria (S15): obrigatória, 32+ bytes aleatórios
AUDIT_HMAC_KEY=troque-por-32-bytes-aleatorios-ou-mais-aqui

# Cookie da sessão (S10)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Strict

# Limitação de taxa por IP (S9)
RATE_LIMIT_ENABLED=true

# Confie em X-Forwarded-For só atrás de proxy conhecido (S13)
TRUST_FORWARDED_FOR=false

# Origens do front liberadas por CORS, separadas por vírgula (S22)
CORS_ALLOWED_ORIGINS=http://localhost:*

# URL pública do front, usada nos links de convite (B9)
FRONTEND_URL=http://localhost:5173

# none (padrão), framework ou native, atrás de proxy TLS (S3)
FORWARD_HEADERS_STRATEGY=none
